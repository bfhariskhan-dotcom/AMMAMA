rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin verification: Super Admin UID or Official Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "OOTzkvnl9uMtd6yDY6D4fojphwv2" ||
        request.auth.token.email == "info@ammamafoods.com"
      );
    }

    // Orders Collection:
    // Customers can place orders (create) & look up their own order by exact Order ID (get).
    // Only Admin can list all orders, update courier status/tracking, or delete.
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Products & Inventory Collection:
    // Public read access for storefront catalog; Admin full create/edit/duplicate/delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection:
    // Public read access for navigation/filter tabs; Admin full create/edit/delete.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Reviews & Feedback Collection:
    // Public can read approved reviews and submit new feedback.
    // Admin can approve, edit, or delete reviews.
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Catch-all protection: Only Admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
